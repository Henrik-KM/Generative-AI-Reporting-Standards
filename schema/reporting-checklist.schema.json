{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reporting-checklist.schema.json",
  "title": "Reporting protocol for generative materials design, version 1.0.0",
  "description": "A machine-readable record of a generative materials-design study under the eight-step reporting protocol. Author records and records completed from a publication give the choice or value used for each item; retrospective audits give a disclosure state. The schema records what was reported and does not assess scientific quality.",
  "type": "object",
  "required": [
    "checklist_version",
    "record_type",
    "study",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "checklist_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "author_record",
        "publication_record",
        "retrospective_audit"
      ],
      "description": "author_record: completed by the authors of the study. publication_record: completed from the publication and its Supplementary Information by anyone, including the authors. retrospective_audit: disclosure states assigned by a reader or reviewer."
    },
    "study": {
      "$ref": "#/$defs/study"
    },
    "items": {
      "type": "array",
      "minItems": 13,
      "maxItems": 15,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/record_item"
          },
          {
            "$ref": "#/$defs/audit_item"
          }
        ]
      }
    },
    "stage_ledger": {
      "type": "array",
      "description": "Optional structured stage ledger. Counts are integers, or null when not stated.",
      "items": {
        "$ref": "#/$defs/ledger_row"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "study": {
      "type": "object",
      "required": [
        "title",
        "citation",
        "workflow_type",
        "assessment_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "workflow_type": {
          "type": "string",
          "minLength": 1
        },
        "assessment_scope": {
          "type": "string",
          "minLength": 1
        },
        "record_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "record_item": {
      "type": "object",
      "required": [
        "id",
        "answer",
        "entry",
        "source_locations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/item_id"
        },
        "answer": {
          "type": "string",
          "enum": [
            "value",
            "not_applicable",
            "not_performed",
            "not_stated"
          ],
          "description": "not_stated is permitted only in publication records."
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "not_stated": {
          "type": "array",
          "description": "Elements of the item that the publication does not state; publication records only.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "audit_item": {
      "type": "object",
      "required": [
        "id",
        "status",
        "summary",
        "source_locations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/item_id"
        },
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "partially_reported",
            "not_reported",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ledger_row": {
      "type": "object",
      "required": [
        "stage",
        "rule",
        "n_in",
        "n_out",
        "evaluator_calls"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "n_in": {
          "type": [
            "integer",
            "null"
          ]
        },
        "n_out": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evaluator_calls": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_per_call": {
          "type": [
            "string",
            "null"
          ]
        },
        "per_cycle": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "item_id": {
      "type": "string",
      "enum": [
        "claim",
        "stage_ledger",
        "data",
        "splits",
        "model",
        "training",
        "generation",
        "evaluation",
        "feasibility",
        "baselines",
        "closed_loop",
        "reproducibility",
        "compute",
        "governance",
        "key_numbers"
      ]
    }
  },
  "x-checklist-order": [
    "claim",
    "stage_ledger",
    "data",
    "splits",
    "model",
    "training",
    "generation",
    "evaluation",
    "feasibility",
    "baselines",
    "closed_loop",
    "reproducibility",
    "compute",
    "governance",
    "key_numbers"
  ],
  "x-step-by-id": {
    "claim": 1,
    "stage_ledger": 2,
    "data": 3,
    "splits": 3,
    "model": 4,
    "training": 4,
    "generation": 4,
    "evaluation": 5,
    "feasibility": 5,
    "baselines": 6,
    "closed_loop": 7,
    "reproducibility": 7,
    "compute": 7,
    "governance": 7,
    "key_numbers": 8
  },
  "x-category-by-id": {
    "claim": "required",
    "stage_ledger": "required",
    "data": "required",
    "splits": "required",
    "model": "required",
    "training": "required",
    "generation": "required",
    "evaluation": "required",
    "feasibility": "required",
    "baselines": "required",
    "closed_loop": "if_applicable",
    "reproducibility": "required",
    "compute": "if_applicable",
    "governance": "if_applicable",
    "key_numbers": "required"
  },
  "x-required-ids-by-record-type": {
    "author_record": [
      "claim",
      "stage_ledger",
      "data",
      "splits",
      "model",
      "training",
      "generation",
      "evaluation",
      "feasibility",
      "baselines",
      "closed_loop",
      "reproducibility",
      "compute",
      "governance",
      "key_numbers"
    ],
    "publication_record": [
      "claim",
      "stage_ledger",
      "data",
      "splits",
      "model",
      "training",
      "generation",
      "evaluation",
      "feasibility",
      "baselines",
      "closed_loop",
      "reproducibility",
      "compute",
      "governance",
      "key_numbers"
    ],
    "retrospective_audit": [
      "data",
      "splits",
      "model",
      "training",
      "generation",
      "evaluation",
      "feasibility",
      "baselines",
      "closed_loop",
      "reproducibility",
      "compute",
      "governance",
      "key_numbers"
    ]
  }
}
