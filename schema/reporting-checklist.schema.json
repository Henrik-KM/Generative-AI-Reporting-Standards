{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reporting-checklist.schema.json",
  "title": "Generative materials design reporting checklist response",
  "description": "A machine-readable author response or retrospective disclosure audit. The schema records reporting completeness and does not assess scientific quality.",
  "type": "object",
  "required": [
    "checklist_version",
    "record_type",
    "study",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "checklist_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "author_response",
        "retrospective_audit"
      ]
    },
    "study": {
      "$ref": "#/$defs/study"
    },
    "items": {
      "type": "array",
      "description": "Include all required and context-dependent identifiers. K1 is optional.",
      "minItems": 12,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "study": {
      "type": "object",
      "required": [
        "title",
        "citation",
        "workflow_type",
        "assessment_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "workflow_type": {
          "type": "string",
          "minLength": 1
        },
        "assessment_scope": {
          "type": "string",
          "minLength": 1
        },
        "audit_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "category",
        "status",
        "summary",
        "source_locations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "D1",
            "S1",
            "M1",
            "T1",
            "G1",
            "E1",
            "B1",
            "F1",
            "R1",
            "CL1",
            "C1",
            "GOV1",
            "K1"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "required",
            "context_dependent",
            "optional_summary"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "partially_reported",
            "not_reported",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "x-checklist-order": [
    "D1",
    "S1",
    "M1",
    "T1",
    "G1",
    "E1",
    "B1",
    "F1",
    "R1",
    "CL1",
    "C1",
    "GOV1",
    "K1"
  ],
  "x-required-record-ids": [
    "D1",
    "S1",
    "M1",
    "T1",
    "G1",
    "E1",
    "B1",
    "F1",
    "R1",
    "CL1",
    "C1",
    "GOV1"
  ],
  "x-category-by-id": {
    "D1": "required",
    "S1": "required",
    "M1": "required",
    "T1": "required",
    "G1": "required",
    "E1": "required",
    "B1": "required",
    "F1": "required",
    "R1": "required",
    "CL1": "context_dependent",
    "C1": "context_dependent",
    "GOV1": "context_dependent",
    "K1": "optional_summary"
  }
}
