{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reporting-checklist.schema.json",
  "title": "Generative materials design reporting checklist response",
  "description": "A machine-readable author response or retrospective disclosure audit. The schema records reporting completeness and does not assess scientific quality.",
  "type": "object",
  "required": [
    "checklist_version",
    "record_type",
    "study",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "checklist_version": {
      "type": "string",
      "enum": ["0.2.0", "1.0.0-draft"]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "author_response",
        "retrospective_audit"
      ]
    },
    "study": {
      "$ref": "#/$defs/study"
    },
    "items": {
      "type": "array",
      "description": "Include all required and context-dependent identifiers. K1 is optional.",
      "minItems": 12,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"checklist_version": {"const": "0.2.0"}}},
      "then": {"properties": {"items": {"items": {
        "properties": {"status": {"enum": ["reported", "partially_reported", "not_reported", "not_applicable"]}},
        "not": {"required": ["details"]},
        "allOf": [{
          "if": {"properties": {"id": {"enum": ["D1", "S1", "M1", "T1", "G1", "E1", "B1", "F1", "R1"]}}},
          "then": {"properties": {"status": {"not": {"const": "not_applicable"}}}}
        }]
      }}}}
    },
    {
      "if": {"properties": {"checklist_version": {"const": "1.0.0-draft"}}},
      "then": {"properties": {"items": {"items": {"allOf": [
        {
          "if": {"properties": {"status": {"const": "not_applicable"}}},
          "then": {"required": ["applicability_reason"]}
        },
        {
          "if": {"properties": {"status": {"const": "not_performed"}}},
          "then": {"required": ["notes"], "properties": {"notes": {"minLength": 1}}}
        }
      ]}}}}
    },
    {
      "if": {"properties": {"checklist_version": {"const": "1.0.0-draft"}, "record_type": {"const": "author_response"}}},
      "then": {"properties": {"items": {"items": {"required": ["details"]}}}}
    }
  ],
  "$defs": {
    "study": {
      "type": "object",
      "required": [
        "title",
        "citation",
        "workflow_type",
        "assessment_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "workflow_type": {
          "type": "string",
          "minLength": 1
        },
        "assessment_scope": {
          "type": "string",
          "minLength": 1
        },
        "audit_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "category",
        "status",
        "summary",
        "source_locations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "D1",
            "S1",
            "M1",
            "T1",
            "G1",
            "E1",
            "B1",
            "F1",
            "R1",
            "CL1",
            "C1",
            "GOV1",
            "K1"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "required",
            "context_dependent",
            "optional_summary"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "partially_reported",
            "not_reported",
            "not_applicable",
            "not_performed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "applicability_reason": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "minProperties": 1,
          "description": "Operational author responses. Missing evidence is distinct from a test known not to have been performed.",
          "additionalProperties": {"$ref": "#/$defs/detail"}
        }
      }
    },
    "detail": {
      "type": "object",
      "required": ["status", "value"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "reported"}}},
          "then": {"required": ["source_locations"], "properties": {"value": {"not": {"enum": [null, ""]}}}},
          "else": {"required": ["rationale"], "properties": {"value": {"type": "null"}}}
        }
      ],
      "properties": {
        "status": {"enum": ["reported", "not_reported", "not_performed", "not_applicable"]},
        "value": {},
        "rationale": {"type": "string", "minLength": 1},
        "source_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "x-checklist-order": [
    "D1",
    "S1",
    "M1",
    "T1",
    "G1",
    "E1",
    "B1",
    "F1",
    "R1",
    "CL1",
    "C1",
    "GOV1",
    "K1"
  ],
  "x-required-record-ids": [
    "D1",
    "S1",
    "M1",
    "T1",
    "G1",
    "E1",
    "B1",
    "F1",
    "R1",
    "CL1",
    "C1",
    "GOV1"
  ],
  "x-category-by-id": {
    "D1": "required",
    "S1": "required",
    "M1": "required",
    "T1": "required",
    "G1": "required",
    "E1": "required",
    "B1": "required",
    "F1": "required",
    "R1": "required",
    "CL1": "context_dependent",
    "C1": "context_dependent",
    "GOV1": "context_dependent",
    "K1": "optional_summary"
  }
}
